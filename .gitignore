__pycache__/
*.pyc

# La sortie de l'anonymiseur tant que la garantie n'est pas franchie : elle
# peut encore porter des noms, et n'a rien à faire dans le dépôt.
*.en-cours

# Fichiers SOURCES lourds, jamais servis par l'app (seul data/horaire-2026.json
# est fetché). Gardés en local, hors du dépôt/GitHub Pages (poids + confidentialité).
data/classeur-2026-brut.json
data/classeur-2026.xlsx
# Brut du recyclage : trigrammes + dates brutes, écrit par mettre-a-jour-recyclage.py
# pour l'audit local. Jamais de nom, mais hors dépôt comme le brut de l'horaire.
data/recyclages-2026-brut.json
# La copie anonymisée du classeur RH et son export entier en JSON, écrits par
# mettre-a-jour-recyclage.py : la réserve, comme classeur-2026.xlsx et son brut.
data/recyclages-2026.xlsx
data/recyclages-2026-classeur.json
# Image non utilisée (logo.svg couvre tout ; logo.png n'est cité qu'en commentaire).
logo.png

# Outillage d'agent installé localement (npx skills) — pas du code du site.
.agents/
.claude/skills/
skills-lock.json
